# DashScope API key for Qwen (Alibaba Cloud) — get one at
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: override the OpenAI-compatible endpoint.
# Leave blank to use the public DashScope endpoint.
# For MaaS workspaces: https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_COMPATIBLE_BASE_URL=
