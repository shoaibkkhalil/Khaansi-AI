# HuggingFace token — required to download the gated google/hear model.
# Get one at https://huggingface.co/settings/tokens and accept the model terms at
# https://huggingface.co/google/hear
HF_TOKEN=hf_your_token_here

# DashScope API key for Qwen (Alibaba Cloud) — only needed for conversational voice mode.
# Get one at https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-key-here

# Optional: override the OpenAI-compatible endpoint.
# Leave blank to use the public DashScope endpoint.
# For MaaS workspaces: https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_COMPATIBLE_BASE_URL=
